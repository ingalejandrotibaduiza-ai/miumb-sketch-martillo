@startuml
class Producto {
  +id: UUID
  +codigo: String
  +nombre: String
  +unidad: String
  +stockMinimo: Decimal
  +activo: Boolean
}
class Stock {
  +productoId: UUID
  +cantidadActual: Decimal
  +actualizar(delta: Decimal)
  +estaEnMinimo(): Boolean
}
class MovimientoInventario {
  +id: UUID
  +tipo: TipoMovimiento
  +cantidad: Decimal
  +fecha: DateTime
  +usuario: String
  +observacion: String
}
enum TipoMovimiento {
  ENTRADA
  SALIDA
}
Producto "1" -- "1" Stock
Producto "1" -- "0..*" MovimientoInventario
MovimientoInventario --> TipoMovimiento
note "SCRUM-12 / SCRUM-13 / SCRUM-14" as N
N .. Producto
@enduml
